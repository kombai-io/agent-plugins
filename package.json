{
  "name": "@kombai/agent-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Host-specific Kombai agent plugin payloads",
  "scripts": {
    "check:codex": "node scripts/codex-plugin.mjs validate",
    "pack:codex": "node scripts/codex-plugin.mjs pack",
    "version:codex": "node scripts/codex-plugin.mjs bump",
    "test:codex": "node --test scripts/codex-plugin.test.mjs",
    "check:claude-code": "node scripts/claude-code-plugin.mjs validate",
    "pack:claude-code": "node scripts/claude-code-plugin.mjs pack",
    "version:claude-code": "node scripts/claude-code-plugin.mjs bump",
    "test:claude-code": "node --test scripts/claude-code-plugin.test.mjs",
    "test": "node --test scripts/*.test.mjs",
    "set-cli-version": "node scripts/cli-version.mjs set",
    "check": "node scripts/cli-version.mjs check && node scripts/codex-plugin.mjs validate && node scripts/claude-code-plugin.mjs validate && node scripts/cursor-plugin.mjs validate && node scripts/vscode-plugin.mjs validate && node scripts/antigravity-plugin.mjs validate && node scripts/gemini-cli-plugin.mjs validate",
    "check:cursor": "node scripts/cursor-plugin.mjs validate",
    "pack:cursor": "node scripts/cursor-plugin.mjs pack",
    "version:cursor": "node scripts/cursor-plugin.mjs bump",
    "test:cursor": "node --test scripts/cursor-plugin.test.mjs",
    "check:vscode": "node scripts/vscode-plugin.mjs validate",
    "pack:vscode": "node scripts/vscode-plugin.mjs pack",
    "version:vscode": "node scripts/vscode-plugin.mjs bump",
    "test:vscode": "node --test scripts/vscode-plugin.test.mjs",
    "check:antigravity": "node scripts/antigravity-plugin.mjs validate",
    "pack:antigravity": "node scripts/antigravity-plugin.mjs pack",
    "version:antigravity": "node scripts/antigravity-plugin.mjs bump",
    "test:antigravity": "node --test scripts/antigravity-plugin.test.mjs",
    "check:gemini-cli": "node scripts/gemini-cli-plugin.mjs validate",
    "pack:gemini-cli": "node scripts/gemini-cli-plugin.mjs pack",
    "version:gemini-cli": "node scripts/gemini-cli-plugin.mjs bump",
    "test:gemini-cli": "node --test scripts/gemini-cli-plugin.test.mjs"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kombai-io/agent-plugins.git"
  }
}
