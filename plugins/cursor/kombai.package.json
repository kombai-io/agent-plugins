{
  "schemaVersion": "kombai-cursor-plugin/v1",
  "name": "kombai",
  "version": "0.1.0",
  "minimumKombaiVersion": "2.0.126",
  "mcpServer": "kombai",
  "mcpTransport": "stdio",
  "localMcp": {
    "owner": "installed-kombai-desktop-app",
    "packagedInstallArgs": [
      "mcp",
      "install",
      "cursor"
    ],
    "requiredTools": [
      "chat_start",
      "chat_status",
      "canvas_read"
    ],
    "authentication": "sign-in-in-kombai-app"
  }
}
